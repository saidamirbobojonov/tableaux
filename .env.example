# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=your-app.up.railway.app,localhost

# ── Database (Railway auto-provides DATABASE_URL when PostgreSQL plugin is added)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── Redis (Railway auto-provides REDIS_URL when Redis plugin is added)
REDIS_URL=redis://default:pass@host:6379

# ── CORS (set to your Next.js frontend URL)
CORS_ALLOWED_ORIGINS=https://your-frontend.up.railway.app

# ── Optional
SENTRY_DSN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
